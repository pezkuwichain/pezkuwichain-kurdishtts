[Unit]
Description=KurdishTTS — Kurdish speech and voice donation
After=network-online.target
Wants=network-online.target

[Service]
User=kurdishtts
Group=kurdishtts
WorkingDirectory=/opt/kurdishtts/app
Environment=HF_HOME=/opt/kurdishtts/hf
Environment=HF_HUB_OFFLINE=1
Environment=KTTS_DATA=/opt/kurdishtts/data
Environment=KTTS_CACHE=/opt/kurdishtts/cache
Environment=KTTS_CLIPS=/opt/kurdishtts/data/clips
Environment=KTTS_KEYS=/opt/kurdishtts/data/api_keys
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kurdishtts/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
MemoryMax=9G

# Hardening: the service reads its code, writes only its own data, and can
# reach the network only to answer (HF downloads happen at deploy, not here).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kurdishtts/data /opt/kurdishtts/cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
